datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model StudyMaterial {
  id            String         @id @default(cuid())
  title         String
  sourceType    String         // "pdf" | "text" | "demo"
  fileName      String?
  pageCount     Int            @default(1)
  extractedText String         // Full combined text
  pageContents  String         // JSON string: array of { pageNumber: number, text: string }
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  topics        Topic[]
  quizAttempts  QuizAttempt[]
  questions     QuizQuestion[]
  revisionTasks RevisionTask[]

  @@index([createdAt])
}

model Topic {
  id          String        @id @default(cuid())
  materialId  String
  name        String
  description String
  order       Int           @default(0)
  createdAt   DateTime      @default(now())

  material    StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
}

model QuizAttempt {
  id             String         @id @default(cuid())
  materialId     String
  score          Int            // e.g. 4
  totalQuestions Int            // e.g. 5
  percentage     Float          // e.g. 80.0
  createdAt      DateTime       @default(now())

  material       StudyMaterial  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  answers        UserAnswer[]
  questions      QuizQuestion[]

  @@index([materialId])
  @@index([createdAt])
}

model QuizQuestion {
  id             String         @id @default(cuid())
  materialId     String
  attemptId      String?
  topicName      String
  question       String
  options        String         // JSON string: string[] (4 options)
  correctAnswer  String         // e.g. option text
  explanation    String
  pageReferences String         // e.g. "Page 2" or JSON array
  createdAt      DateTime       @default(now())

  material       StudyMaterial  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  attempt        QuizAttempt?   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  answers        UserAnswer[]

  @@index([materialId])
  @@index([attemptId])
  @@index([topicName])
}

model UserAnswer {
  id             String        @id @default(cuid())
  attemptId      String
  questionId     String
  selectedOption String
  isCorrect      Boolean
  createdAt      DateTime      @default(now())

  attempt        QuizAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       QuizQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([questionId])
}

model RevisionTask {
  id                  String        @id @default(cuid())
  materialId          String
  topicName           String
  recommendedActivity String
  priority            String        // "HIGH" | "MEDIUM" | "LOW"
  status              String        @default("PENDING") // "PENDING" | "COMPLETED"
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  material            StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([status])
  @@index([priority])
}
